{
  "name": "graphos-world-plugin",
  "version": "1.0.12",
  "type": "module",
  "graphos": {
    "plugin": {
      "entry": "plugin/dist/plugin.js"
    }
  },
  "main": "plugin/dist/index.js",
  "files": [
    "dist/",
    "plugin/dist/"
  ],
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "npm run build:app && npm run build:plugin",
    "build:app": "vite build --sourcemap",
    "build:plugin": "cd plugin && tsc",
    "preview": "vite preview",
    "clean": "rm -rf dist && rm -rf plugin/dist",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/express": "^4.17.21",
    "@types/lodash": "^4.17.24",
    "@types/node": "^22.14.0",
    "@types/react-grid-layout": "^1.3.6",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "graphos-core": "^1.0.6",
    "lodash": "^4.18.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-grid-layout": "^1.5.3",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
